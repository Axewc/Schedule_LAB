# Database (runtime - pooler URL for Supabase, direct URL for local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/schedule_lab"
# DIRECT_URL is used by prisma.config.ts for migrations (bypasses PgBouncer in Supabase).
# For local dev without pooling, leave this unset — prisma.config.ts falls back to DATABASE_URL.
# DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Stripe
STRIPE_SECRET_KEY="sk_test_dummy_key_for_build_only"
STRIPE_PUBLISHABLE_KEY="pk_test_dummy_key_for_build_only"
STRIPE_WEBHOOK_SECRET="whsec_dummy_secret_for_build_only"

# Resend
RESEND_API_KEY="re_dummy_key_for_build_only"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_dummy_key_for_build_only"

# Email
FROM_EMAIL="Consultorio <citas@consultorio.com>"
DOCTOR_EMAIL="doctor@consultorio.com"
CLINIC_ADDRESS="Av. Insurgentes Sur 1234, CDMX"
MAPS_URL=""

# Auth
AUTH_SECRET="this-is-a-dummy-secret-for-build-purposes-only-32chars"

# Cron
CRON_SECRET="dummy-cron-secret"